# ─── Hardhat Deployment ───────────────────────────────────────────
# Your MetaMask wallet private key (NEVER commit this to git!)
PRIVATE_KEY=your_metamask_private_key_here

# Polygon Amoy RPC (default works, or use Alchemy/Infura)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Polygonscan API key (for contract verification, optional)
POLYGONSCAN_API_KEY=your_polygonscan_api_key

# ─── Frontend ─────────────────────────────────────────────────────
# Paste the deployed contract address after running: npm run deploy:amoy
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
